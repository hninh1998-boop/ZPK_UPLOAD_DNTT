projection;
strict ( 2 );
use draft;

define behavior for ZC_UP_DNTT_HEAD alias Head
use etag
{
  use create;
  use update;
  use delete; // feature control ( features : instance ) kế thừa từ ZI_UP_DNTT_HEAD

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZC_UP_DNTT_ITEM alias Item
use etag
{
  use update;
  use delete;

  use association _Head { with draft; }
}